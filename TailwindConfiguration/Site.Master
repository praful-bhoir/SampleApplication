<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="TailwindConfiguration.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Tailwind UI Components - Form Controls Demo</title>

    <link href="Assets/tailwind/output.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <style>
        /* Custom animations and styles */
        .gradient-text {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .toggle-checkbox:checked {
            background-color: #9333ea;
            border-color: #9333ea;
        }

            .toggle-checkbox:checked + .toggle-label {
                background-color: #9333ea;
                transform: translateX(20px);
            }

        /* Custom range slider */
        input[type="range"] {
            -webkit-appearance: none;
            appearance: none;
            background: transparent;
            cursor: pointer;
        }

            input[type="range"]::-webkit-slider-track {
                background: #e5e7eb;
                height: 6px;
                border-radius: 3px;
            }

            input[type="range"]::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                background: #9333ea;
                height: 20px;
                width: 20px;
                border-radius: 50%;
                margin-top: -7px;
            }

            input[type="range"]::-moz-range-track {
                background: #e5e7eb;
                height: 6px;
                border-radius: 3px;
            }

            input[type="range"]::-moz-range-thumb {
                background: #9333ea;
                height: 20px;
                width: 20px;
                border-radius: 50%;
                border: none;
            }

        .dark input[type="range"]::-webkit-slider-track {
            background: #4b5563;
        }

        .dark input[type="range"]::-moz-range-track {
            background: #4b5563;
        }

        /* Floating label animation */
        .floating-label {
            transition: all 0.2s ease;
        }

        .has-value .floating-label,
        .focus-within .floating-label {
            transform: translateY(-1.5rem) scale(0.85);
            color: #9333ea;
        }

        /* File input custom styling */
        .file-input::-webkit-file-upload-button {
            visibility: hidden;
        }

        .file-input::before {
            content: 'Choose File';
            display: inline-block;
            background: #9333ea;
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 0.375rem;
            cursor: pointer;
            margin-right: 1rem;
            transition: background-color 0.2s;
        }

        .file-input:hover::before {
            background: #7c3aed;
        }

        /* Checkbox and radio custom */
        input[type="checkbox"]:checked,
        input[type="radio"]:checked {
            background-color: #9333ea;
            border-color: #9333ea;
        }

        /* Loading spinner */
        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .animate-spin {
            animation: spin 1s linear infinite;
        }

        /* Gradient styles */
        .gradient-text {
            @apply bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent;
        }

        .gradient-bg {
            @apply bg-gradient-to-r from-purple-600 to-pink-600;
        }
    </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 transition-colors duration-300">
    <form id="form1" runat="server">
